{
  "name": "genus_contabilidade",
  "version": "0.1.0",
  "private": true,
  "description": "Portal de contabilidade: clientes, extratos bancários e importação de PDFs.",
  "author": "Genus Contabilidade",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:status": "prisma migrate status",
    "postinstall": "prisma generate",
    "test:load": "node scripts/stress-tests/01-load-concurrency-test.mjs",
    "test:crash": "node scripts/stress-tests/02-crash-interruption-test.mjs",
    "test:lock": "node scripts/stress-tests/03-lock-contention-test.mjs",
    "test:stress": "node scripts/stress-tests/run-all.mjs",
    "electron:prepare": "next build --webpack && node scripts/electron/prepare-resources.mjs",
    "electron:dev": "electron .",
    "electron:dist": "npm run electron:prepare && electron-builder"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@prisma/adapter-better-sqlite3": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcrypt": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "dotenv": "^17.4.2",
    "lucide-react": "^1.45.0",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@tailwindcss/postcss": "^4",
    "@types/bcrypt": "^6.0.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20.19.43",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^38.8.6",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "prisma": "^7.10.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "allowScripts": {
    "@prisma/engines@7.10.0": true,
    "bcrypt@6.0.0": true,
    "better-sqlite3@12.11.1": true,
    "prisma@7.10.0": true,
    "unrs-resolver@1.12.2": true
  },
  "build": {
    "appId": "com.genuscontabilidade.app",
    "productName": "Genus Contabilidade",
    "directories": {
      "output": ".DIST"
    },
    "npmRebuild": false,
    "files": [
      "electron/main.cjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "electron/resources/app-server",
        "to": "app-server"
      },
      {
        "from": "electron/resources/template.db",
        "to": "template.db"
      },
      {
        "from": "electron/resources/python-installer.exe",
        "to": "python-installer.exe"
      }
    ],
    "win": {
      "target": "portable"
    }
  }
}
